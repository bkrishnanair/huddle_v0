# Huddle — environment template
#
# Copy to .env.local and fill in. Run `npm run preflight` to check what's missing.
# IMPORTANT: Vercel does NOT read .env.local. Every variable below must ALSO be
# set in the Vercel dashboard for production, or the feature silently no-ops.
#
# Rule (CLAUDE.md #5): no secret ever gets a NEXT_PUBLIC_ prefix. Anything
# prefixed NEXT_PUBLIC_ ships to the browser and is public by definition.

# --- Firebase client (public by design) -------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional: canonical app URL (defaults to https://huddlemap.live)
NEXT_PUBLIC_APP_URL=

# --- Firebase Admin SDK (SECRET) --------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Google Maps -------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_STYLE_MAP_ID=
# Server-side key without HTTP referrer restrictions, used by the TerpLink
# scraper for geocoding. Without it the scraper falls back to the client key,
# which may be referrer-blocked.
GOOGLE_MAPS_SERVER_KEY=

# --- Cron plan / cadence -----------------------------------------------------
# CRON_PLAN and CRON_MODE must agree with the vercel.json schedule AND with the
# maxDuration literal in app/api/cron/dispatch/route.ts. The dispatcher logs a
# warning at startup if they disagree.
#
#   Plan    CRON_PLAN  CRON_MODE  vercel.json schedule  maxDuration literal
#   ------- ---------- ---------- --------------------- -------------------
#   Hobby   hobby      daily      "0 14 * * *"          60     <- shipped default
#   Pro     pro        hourly     "0 * * * *"           300
#
# Defaults (both unset): hobby + hourly. That combination fires once a day but
# only runs the two hourly handlers — cleanup and post-event-prompt never fire.
# On Hobby you MUST set CRON_MODE=daily.
CRON_PLAN=hobby
CRON_MODE=daily

# --- Cron auth (SECRET) ------------------------------------------------------
# Bearer token for all /api/cron/* routes. Without it every cron returns 401:
# reminders, cleanup, serendipity, scheduled-messages, post-event-prompt.
CRON_SECRET=

# --- Email — Resend (SECRET) -------------------------------------------------
# WITHOUT THIS, T-24h REMINDER EMAILS SILENTLY DO NOT SEND. lib/email.ts logs a
# warning and returns { success: false }. In-app notifications still write, so
# the UI looks healthy while zero email leaves the system.
# Verify the sending domain in the Resend dashboard before launch.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Web push — FCM ----------------------------------------------------------
# Firebase Console > Project Settings > Cloud Messaging > Web Push certificates.
# WITHOUT THIS, getToken() cannot mint a token and ZERO push notifications are
# delivered, however healthy the service worker looks.
NEXT_PUBLIC_VAPID_KEY=

# --- Referenced in code but intentionally unset ------------------------------
# Both are read somewhere in the source, so the drift check requires them to be
# listed. Neither should be given a value.
#
# NEXT_PUBLIC_CRON_SECRET: read by app/(app)/admin/page.tsx to trigger the
#   serendipity agent from the admin UI. Setting it would ship the cron secret
#   to every browser, violating the no-secret-with-NEXT_PUBLIC_ rule. The button
#   has never worked; the correct fix is an admin-token-gated trigger route.
#   LEAVE UNSET.
# RECAPTCHA_SECRET_KEY: read by lib/recaptcha.ts, which has zero callers. Wire
#   verifyRecaptcha() into a real flow or delete the module.
NEXT_PUBLIC_CRON_SECRET=
RECAPTCHA_SECRET_KEY=

# --- Gemini (SECRET) ---------------------------------------------------------
GEMINI_API_KEY=

# --- Admin -------------------------------------------------------------------
# Firebase UID allowed to read /api/admin/*.
ADMIN_UID=
